{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "treniday-web",
      "runtimeExecutable": "flutter",
      "runtimeArgs": ["run", "-d", "web-server", "--web-port", "8099"],
      "port": 8099
    },
    {
      "name": "lottie-sheets",
      "runtimeExecutable": "python",
      "runtimeArgs": ["-m", "http.server", "8098", "--directory", "build"],
      "port": 8098
    },
    {
      "name": "treniday-site",
      "runtimeExecutable": "python3",
      "runtimeArgs": ["-m", "http.server", "8097", "--directory", "build/site_preview"],
      "port": 8097
    }
  ]
}
