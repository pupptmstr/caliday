<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_root" android:layout_width="match_parent"
    android:layout_height="match_parent" android:background="@drawable/widget_bg_brand" android:padding="12dp"
    android:orientation="horizontal">
    <ImageView android:id="@+id/widget_goro" style="@style/WidgetGoro" android:layout_width="128dp"
        android:layout_height="match_parent" android:src="@drawable/goro_pose_flag" />
    <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
        android:layout_marginStart="10dp" android:orientation="vertical">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical">
            <ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_widget_flame"
                android:contentDescription="@null" />
            <TextView android:id="@+id/streak_big" style="@style/WidgetText.Black" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:textSize="28sp" android:textColor="#FF9500" android:text="0" />
            <TextView android:id="@+id/streak_unit" style="@style/WidgetText" android:layout_width="0dp"
                android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="6dp"
                android:textSize="13sp" android:alpha="0.8" />
            <TextView android:id="@+id/chip_freeze" style="@style/WidgetChip.Freeze" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:text="0" android:visibility="gone" />
        </LinearLayout>
        <FrameLayout android:layout_width="1dp" android:layout_height="0dp" android:layout_weight="1" />
        <TextView android:id="@+id/sp_rank" style="@style/WidgetText" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:textSize="13sp" android:alpha="0.85"
            android:drawableStart="@drawable/ic_widget_bolt_s" android:drawablePadding="4dp" />
        <FrameLayout android:layout_width="1dp" android:layout_height="0dp" android:layout_weight="1" />
        <include layout="@layout/widget_week" />
        <FrameLayout android:layout_width="1dp" android:layout_height="0dp" android:layout_weight="1" />
        <FrameLayout android:layout_width="match_parent" android:layout_height="wrap_content">
            <TextView android:id="@+id/plan_pill" style="@style/WidgetText.Black" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:background="@drawable/widget_pill" android:paddingStart="11dp"
                android:paddingEnd="11dp" android:paddingTop="5dp" android:paddingBottom="5dp" android:textSize="12.5sp"
                android:textColor="#1A5FA8" android:drawableStart="@drawable/ic_widget_play_s" android:drawablePadding="5dp"
                android:visibility="gone" />
            <TextView android:id="@+id/caption_plan" style="@style/WidgetText.Black" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:textSize="13sp" android:visibility="gone" />
            <LinearLayout android:id="@+id/caption_done" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical" android:visibility="gone">
            <ImageView android:layout_width="15dp" android:layout_height="15dp" android:src="@drawable/ic_widget_check"
                android:contentDescription="@null" />
            <TextView android:id="@+id/caption_done_text" style="@style/WidgetText" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:layout_marginStart="5dp" android:textSize="13sp" />
        </LinearLayout>
        </FrameLayout>
    </LinearLayout>
</LinearLayout>
